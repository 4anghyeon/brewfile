# --- Fonts ---
cask "font-jetbrains-mono-nerd-font"
cask "font-iosevka"

# --- CLI Tools ---
brew "git"                            # 버전 관리 시스템
brew "gh"                             # GitHub CLI
brew "curl"                           # HTTP 요청 도구
brew "wget"                           # 파일 다운로드 도구
brew "eza"                            # ls 대체
brew "tree"                           # 디렉토리 트리 출력
brew "mise"                           # Node/Python 등 런타임 버전 관리
brew "lazygit"                        # Git TUI 클라이언트
brew "ffmpeg"                         # 미디어 인코딩 변환
brew "PeonPing/tap/peon-ping"         # claude-code 알림 사운드 유틸리티

# --- Terminal & Editor ---
cask "warp"                           # AI 지원 터미널
cask "zed"
cask "visual-studio-code"
cask "jetbrains-toolbox"              # JetBrains IDE 통합 관리
