# ============================================================
# Brewfile.base — 공통 (모든 환경에서 설치)
# ============================================================

# Formula
brew "git"
brew "gh"                   # GitHub CLI
brew "curl"
brew "wget"
brew "eza"                  # ls 대체
brew "mise"                 # Node/Python 등 런타임 버전 관리

## Shell
brew "zsh"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-completions"

## Other Utils
brew "tree"

# Cask
## Fonts
cask "font-jetbrains-mono-nerd-font"
cask "font-pretendard"
case "font-iosevka"
